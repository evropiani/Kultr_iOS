      }
    },
    "Widgets on Home": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Widgets auf der Startseite"
          }
        }
      }
    },
    "Widgets sit at the top of Home: drag to move one, tap the red button to take it off, tap its size to change it. On Home itself, hold a widget for the same choices.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Widgets stehen oben auf der Startseite: Zieh eines, um es zu verschieben, tippe auf den roten Knopf, um es zu entfernen, und auf seine Größe, um sie zu ändern. Auf der Startseite selbst bekommst du dieselbe Auswahl, wenn du ein Widget gedrückt hältst."
          }
        }
      }
    },
