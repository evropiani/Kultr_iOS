    },
    "“%@” will be kept as a playlist": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "„%@“ wird als Playlist behalten"
          }
        }
      }
    },
    "“Download on Wi-Fi only” is on, and this phone is on mobile data. Downloads start by themselves once you are on Wi-Fi and Kultr is open.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "„Nur im WLAN laden“ ist an, und dieses Telefon nutzt mobile Daten. Downloads starten von selbst, sobald du im WLAN bist und Kultr offen ist."
          }
        }
      }
    },
    "…and %@": {
      "extractionState": "manual",
      "localizations": {
        "de": {
