    "Your most-played tracks, by the play count on the server.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Deine meistgespielten Titel, nach den Wiedergaben auf dem Server."
          }
        }
      }
    },
    "Your notes": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Deine Notizen"
          }
        }
      }
    },
    "Your own stations and changes go; Warm Up, Night Drive, Peak Hour, Deep Focus, Wind Down, Unplayed gems and Favourites come back.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Deine eigenen Stationen und Änderungen verschwinden; Aufwärmen, Nachtfahrt, Höhepunkt, Voller Fokus, Runterkommen, Ungehörte Perlen und Favoriten kommen zurück."
          }
        }
      }
    },
    "Your server is too old for this client.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dein Server ist zu alt für diese App."
          }
