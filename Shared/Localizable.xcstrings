    "Beat-matched at %@ BPM — the next track down %@, and it stays at that tempo, so no track changes speed while it plays": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Im Takt bei %@ BPM – der nächste Titel %@ langsamer, und er bleibt bei diesem Tempo, sodass kein Titel während der Wiedergabe die Geschwindigkeit ändert"
          }
        }
      }
    },
    "Beat-matched at %@ BPM — the next track up %@, and it stays at that tempo, so no track changes speed while it plays": {
      "extractionState": "manual",
