        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "InjeKt · %@⇄%@ @ %@ BPM · %@ Takte"
          }
        }
      }
    },
    "Installed Kultr with Sideloadly, AltServer or Impactor rather than %@? Install the new version the same way, with the same Apple ID. Your library, downloads and settings stay.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Kultr mit Sideloadly, AltServer oder Impactor statt mit %@ installiert? Installiere die neue Version genauso, mit derselben Apple-ID. Mediathek, Downloads und Einstellungen bleiben."
          }
        }
      }
    },
