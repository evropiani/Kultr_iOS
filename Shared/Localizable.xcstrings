    "Use": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Verwenden"
          }
        }
      }
    },
    "Use a link from the clipboard": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Link aus der Zwischenablage verwenden"
          }
        }
      }
    },
    "Use Download on an album, artist or playlist — or drag anything onto “Sync offline” — to keep it on this phone.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Tippe bei einem Album, Künstler oder einer Playlist auf „Laden“ – oder zieh etwas auf „Offline synchronisieren“ –, um es auf diesem Telefon zu behalten."
          }
        }
      }
    },
    "Use Download on any album, artist, playlist or track — or drag it onto “Sync offline” — to keep it here for when you have no connection.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Tippe bei einem Album, Künstler, einer Playlist oder einem Titel auf „Laden“ – oder zieh es auf „Offline synchronisieren“ –, um es für Zeiten ohne Verbindung hier zu behalten."
          }
        }
      }
    },
    "Use mobile data too": {
      "extractionState": "manual",
      "localizations": {
