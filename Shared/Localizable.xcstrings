        }
      }
    },
    "Hold a widget on Home for a menu: Edit widgets, Size, Add a widget and Remove. In 2.0.0, holding one did nothing.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Halte ein Widget auf der Startseite gedrückt, um ein Menü zu öffnen: Widgets bearbeiten, Größe, Widget hinzufügen und Entfernen. In 2.0.0 passierte beim Halten nichts."
          }
        }
      }
    },
