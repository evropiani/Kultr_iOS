      }
    },
    "A crate": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Eine Kiste"
          }
        }
      }
    },
    "A crate holds albums, artists and tracks you choose: hold any of them and tap Add to crate. Or let rules fill it, like “4 stars and up, added this year”.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Eine Kiste enthält Alben, Künstler und Titel, die du auswählst: Halte etwas davon gedrückt und tippe auf „Zur Kiste hinzufügen“. Oder lass Regeln sie füllen, etwa „ab 4 Sternen, dieses Jahr hinzugefügt“."
          }
        }
      }
    },
    "A different handful of albums every time.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Jedes Mal eine andere Handvoll Alben."
          }
        }
      }
    },
    "A different handful of artists every time.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Jedes Mal eine andere Handvoll Künstler."
          }
        }
      }
    },
    "A different handful of tracks every time you open the page.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Jedes Mal, wenn du die Seite öffnest, eine andere Handvoll Titel."
          }
        }
      }
    },
    "A Kultr style someone shared: the look only, nothing else.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein Kultr-Stil, den jemand geteilt hat: nur das Aussehen, sonst nichts."
          }
        }
      }
    },
