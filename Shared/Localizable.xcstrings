        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Im Takt bei %@ BPM – der nächste Titel %@ schneller, und er bleibt bei diesem Tempo, sodass kein Titel während der Wiedergabe die Geschwindigkeit ändert"
          }
        }
      }
    },
