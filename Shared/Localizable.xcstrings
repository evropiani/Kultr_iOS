          }
        }
      }
    },
    "The current and next track are always analysed when a track starts. This also measures the one after, so skipping ahead lands on a transition that is ready too.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der aktuelle und der nächste Titel werden immer analysiert, wenn ein Titel beginnt. Damit wird auch der übernächste vermessen, sodass auch beim Weiterspringen ein fertiger Übergang wartet."
          }
        }
      }
    },
