    },
    "A station for every decade with at least 20 tracks, from the years in your tags.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Eine Station für jedes Jahrzehnt mit mindestens 20 Titeln, nach den Jahreszahlen in deinen Tags."
          }
        }
      }
    },
    "A style is only the look: your library, servers and other settings stay as they are.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein Stil ist nur das Aussehen: Mediathek, Server und andere Einstellungen bleiben, wie sie sind."
          }
        }
      }
    },
    "A word of your own, like “gym” or “rainy day”.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein eigenes Wort, etwa „Training“ oder „Regentag“."
