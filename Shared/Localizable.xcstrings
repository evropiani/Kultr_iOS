            "value": "Deine Notizen"
          }
        }
      }
    },
    "Your own stations and changes go; Warm Up, Night Drive, Peak Hour, Deep Focus, Wind Down, Unplayed gems and Favourites come back.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Deine eigenen Stationen und Änderungen verschwinden; Aufwärmen, Nachtfahrt, Höhepunkt, Voller Fokus, Runterkommen, Ungehörte Perlen und Favoriten kommen zurück."
          }
        }
      }
    },
    "Your password stays on this phone, sealed in the iOS Keychain, and is only ever sent to your own server.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dein Passwort bleibt auf diesem Telefon, sicher im iOS-Schlüsselbund, und wird nur an deinen eigenen Server gesendet."
          }
        }
      }
    },
    "Your server counts plays per track, not each play, so this chart comes from this phone's own history.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dein Server zählt Wiedergaben pro Titel, nicht jede einzelne. Darum stammt dieses Diagramm aus dem eigenen Verlauf dieses Telefons."
          }
        }
      }
    },
    "Your server is too old for this client.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dein Server ist zu alt für diese App."
          }
        }
      }
    },
    "Your stations": {
      "extractionState": "manual",
      "localizations": {
